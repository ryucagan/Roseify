# Get a key at https://developer.riotgames.com  (dev keys expire every 24h)
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Default League platform: tr1, euw1, eun1, na1, kr, br1, la1, la2, jp1, oc1, ru, me1, sg2, tw2, vn2, ph2, th2
LOL_PLATFORM=tr1
# Default Valorant shard: eu, na, ap, kr, br, latam   (auto-detected per player when possible)
VAL_SHARD=eu

PORT=3000
# Requests allowed per window, "count:seconds" pairs. Dev/personal key = 20:1,100:120
RATE_LIMITS=20:1,100:120
# Set DEMO=1 to run with generated sample data (also on automatically if no key is set)
DEMO=0
